<Window x:Class="Vezerlok2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vezérlők" Height="940" Width="975"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Fájl">
                <MenuItem Header="Megnyitás" Click="Megnyitas_Click"/>
                <MenuItem Header="Mentés" Click="Mentes_Click"/>
                <Separator/>
                <MenuItem Header="Kilépés" Click="Kilepes_Click"/>
            </MenuItem>
            <MenuItem Header="Nézet"/>
            <MenuItem Header="Súgó"/>
        </Menu>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Kész" VerticalAlignment="Center"/>
                    <ProgressBar Width="125" Height="18" Margin="5,0,0,0" Value="40"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <ScrollViewer VerticalScrollBarVisibility="Visible">
            <StackPanel Margin="20,10,20,10" TextElement.FontWeight="Bold">

                <GroupBox Header="Alap vezérlők" Padding="15,5,15,10">
                    <StackPanel>
                        <DockPanel>
                            <Label DockPanel.Dock="Left" Width="305" Content="Felhasználónév:" VerticalAlignment="Top"/>
                            <TextBox x:Name="txtFelhasznalo" Text="kisi" Width="250" Height="23"
                                     HorizontalAlignment="Left" Margin="0,25,0,0" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <DockPanel>
                            <Label DockPanel.Dock="Left" Width="305" Content="Jelszó:" VerticalAlignment="Top"/>
                            <PasswordBox x:Name="pwdJelszo" Password="1234" Width="250" Height="23"
                                         HorizontalAlignment="Left" Margin="0,25,0,0" VerticalContentAlignment="Center"/>
                        </DockPanel>
                        <CheckBox x:Name="chkFeltetelek" Content="Felhasználási feltételek elfogadása"
                                  IsChecked="True" Margin="0,5,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <RadioButton x:Name="rbFerfi" Content="Férfi" GroupName="Nem" IsChecked="True" Margin="0,0,12,0"/>
                            <RadioButton x:Name="rbNo" Content="Nő" GroupName="Nem"/>
                        </StackPanel>
                        <Button x:Name="btnKuldes" Content="Küldés" Width="125" Height="25"
                                HorizontalAlignment="Center" Margin="0,12,0,0" Click="Kuldes_Click"/>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Lista vezérlők" Margin="0,15,0,0" Padding="15,5,15,10" Height="268">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="292">
                            <Label Content="ListBox:"/>
                            <ListBox x:Name="lbGyumolcsok" Height="125" SelectedIndex="2">
                                <ListBoxItem Content="Alma"/>
                                <ListBoxItem Content="Körte"/>
                                <ListBoxItem Content="Banán"/>
                            </ListBox>
                        </StackPanel>

                        <StackPanel Width="290" Margin="5,0,0,0">
                            <Label Content="ComboBox:"/>
                            <ComboBox x:Name="cbEvszak" Width="187" Height="27" SelectedIndex="0"
                                      HorizontalAlignment="Left" Margin="45,0,0,0" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="Tavaszi"/>
                                <ComboBoxItem Content="Nyári"/>
                                <ComboBoxItem Content="Őszi"/>
                                <ComboBoxItem Content="Téli"/>
                            </ComboBox>
                            <Label Content="Slider:" Margin="0,10,0,0"/>
                            <Slider x:Name="sldErtek" Width="175" Minimum="0" Maximum="100" Value="25"
                                    HorizontalAlignment="Left" Margin="50,0,0,0"/>
                        </StackPanel>

                        <StackPanel Width="290">
                            <Label Content="ProgressBar:"/>
                            <ProgressBar x:Name="pbFolyamat" Width="187" Height="25" Value="75"
                                         HorizontalAlignment="Left" Margin="45,0,0,0"/>
                            <Label Content="Image:" Margin="0,20,0,0"/>
                            <Image x:Name="imgKep" Width="150" Height="80" HorizontalAlignment="Left" Margin="45,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Haladó elemek" Margin="0,15,0,0" Padding="15,10,15,10">
                    <TabControl SelectedIndex="1" Height="320">
                        <TabItem Header="Adatok">
                            <DataGrid x:Name="dgAdatok" AutoGenerateColumns="True" IsReadOnly="True"/>
                        </TabItem>
                        <TabItem Header="Fa nézet">
                            <TreeView Margin="2">
                                <TreeViewItem Header="Gyümölcsök" IsExpanded="True">
                                    <TreeViewItem Header="Alma"/>
                                    <TreeViewItem Header="Banán"/>
                                    <TreeViewItem Header="Körte"/>
                                </TreeViewItem>
                                <TreeViewItem Header="Zöldségek" IsExpanded="True">
                                    <TreeViewItem Header="Répa"/>
                                    <TreeViewItem Header="Uborka"/>
                                </TreeViewItem>
                            </TreeView>
                        </TabItem>
                        <TabItem Header="Expander">
                            <StackPanel Margin="5">
                                <Expander Header="Részletek" IsExpanded="True">
                                    <TextBlock FontWeight="Normal" Margin="20,5,0,0" TextWrapping="Wrap"
                                               Text="Ez egy Expander vezérlő tartalma."/>
                                </Expander>
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>